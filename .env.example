# Copy to .env for local development. .env is git-ignored. Never commit real values.
# All variables for this project use the PSXNI_ prefix so they cannot collide with,
# or be mistaken for, credentials belonging to any other project (ADR-0001).

# Environment name: local | ci | production
PSXNI_ENV=local

# Global kill switch for collectors and LLM calls (spec section 17). "true" stops all jobs.
PSXNI_KILL_SWITCH=false

# --- Phase 1 (NOT YET ENABLED: awaiting approval) ---
# Dedicated Turso database for THIS project only. Do not reuse any other project's database or token.
# PSXNI_TURSO_DATABASE_URL=
# PSXNI_TURSO_AUTH_TOKEN=

# --- Phase 3 (NOT YET ENABLED) ---
# PSXNI_LLM_API_KEY=
# PSXNI_LLM_DAILY_BUDGET_USD=
