# Copy to .env for local development. .env is git-ignored. Never commit real values.
# All variables for this project use the PSXNI_ prefix so they cannot collide with,
# or be mistaken for, credentials belonging to any other project (ADR-0001).

# Environment name: local | ci | production
PSXNI_ENV=local

# Global kill switch for collectors and LLM calls (spec section 17). "true" stops all jobs.
PSXNI_KILL_SWITCH=false

# --- Phase 1: dedicated Turso database for THIS project only ---
# Never reuse any other project's database or token. Never commit real values.
PSXNI_TURSO_DATABASE_URL=libsql://<your-database>.turso.io
PSXNI_TURSO_AUTH_TOKEN=

# --- Phase 3 (NOT YET ENABLED) ---
# PSXNI_LLM_API_KEY=
# PSXNI_LLM_DAILY_BUDGET_USD=

# Free-tier LLM keys. Each vendor accepts numbered names so several accounts share one vendor's quota;
# the chain is Groq (rotating) -> Gemini -> OpenRouter. Real values live in GitHub Actions secrets only.
# PSXNI_GROQ_API_KEY_ONE=
# PSXNI_GROQ_API_KEY_TWO=
# PSXNI_GROQ_API_KEY_THREE=
# PSXNI_GEMINI_API_KEY_ONE=
# PSXNI_OPENROUTER_API_KEY_ONE=
# Optional model overrides (defaults in engines/llm.py):
# PSXNI_LLM_GROQ_MODEL=
# PSXNI_LLM_GEMINI_MODEL=
# PSXNI_LLM_OPENROUTER_MODEL=
